{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonata",
  "version": "1.0.7",
  "identifier": "io.sonata.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Sonata", "width": 1100, "height": 720, "minWidth": 760, "minHeight": 480 }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEM0VENENCOEI1NDAwRTMKUldUakFGU0x5OVErUGFtZlJFNm9kdzZEdHhEdEwrSmo3RG1kQnpXOXFNSWpVRkRGZlF1VkpxTDUK",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
